# Copy to .env locally, or set these securely in the execution environment.
# Leave credentials blank until you configure your own keys. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint with structured-output support:
# OPENAI_BASE_URL=https://api.openai.com/v1

# Tracing is optional. No LangSmith key is needed when disabled.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ma-trace-banking
